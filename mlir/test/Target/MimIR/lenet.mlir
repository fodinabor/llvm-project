// RUN: mlir-translate --mlir-to-mim %s | FileCheck %s

// LeNet-style CNN: pad, two convolution + bias + ReLU + pooling stages
// (max and average pooling), flatten, and a final linear layer.

// CHECK-LABEL: fun extern main (

// Input zero-padding of the two spatial axes.
// CHECK-DAG: %tensor.pad (%math.F (23, 8), 4) (2, 1, 28, 28) (0, (0, 0, 2, 2), (0, 0, 2, 2))

// Two convolutions over a float ring; the broadcast bias is added
// elementwise afterwards (add_init over the conv and the broadcast copy).
// CHECK-DAG: %tensor.conv (%math.F (23, 8), 0:(%math.F (23, 8)), ring_fadd_{{[0-9]+}}, ring_fmul_{{[0-9]+}}) (2, 1, 4, 32, 32, 5, 5) (‹2; 1›, ‹2; 1›, ‹2; 0›)
// CHECK-DAG: %tensor.conv (%math.F (23, 8), 0:(%math.F (23, 8)), ring_fadd_{{[0-9]+}}, ring_fmul_{{[0-9]+}}) (2, 4, 6, 14, 14, 5, 5) (‹2; 1›, ‹2; 1›, ‹2; 0›)
// CHECK-DAG: add_init_{{[0-9]+}}
// CHECK-DAG: broadcast_copy_{{[0-9]+}}

// Max pooling seeded with -inf, sum pooling seeded with 0.
// CHECK-DAG: %tensor.pool (%math.F (23, 8)) (pool_max_{{[0-9]+}}, 4286578688:(%math.F (23, 8))) (2, 4, 28, 28) (‹2; 2›, ‹2; 2›, ‹2; 1›, ‹2; 0›, ‹2; 14›)
// CHECK-DAG: %tensor.pool (%math.F (23, 8)) (pool_sum_{{[0-9]+}}, 0:(%math.F (23, 8))) (2, 6, 10, 10) (‹2; 2›, ‹2; 2›, ‹2; 1›, ‹2; 0›, ‹2; 5›)

// The average divisor generic uses linalg.index: the fold receives the two
// spatial indices as extra iota inputs.
// CHECK-DAG: %tensor.map_reduce 3 (%math.F (23, 8), 4, 0) ‹2; (2, 6, 5, 5)› ((%math.F (23, 8), I64, I64), (4, 1, 1), ((2, 6, 5, 5), 5, 5))
// CHECK-DAG: (0I64, 1I64, 2I64, 3I64, 4I64)

// Flatten and the final linear layer.
// CHECK-DAG: %tensor.reshape (%math.F (23, 8), 4, 2) (2, 6, 5, 5) (2, 150)
// CHECK-DAG: %tensor.dot_product {{.*}} ((2, 150), (150, 10))

// The divisor fold: clamped-window arithmetic over the iota indices.
// CHECK: fun linalg_body_{{[0-9]+}} ((_{{[0-9]+}}: %math.F (23, 8), (_{{[0-9]+}}: %math.F (23, 8), _{{[0-9]+}}: I64, _{{[0-9]+}}: I64)
// CHECK-DAG: %core.wrap.mul
// CHECK-DAG: %core.extrema.Sm
// CHECK-DAG: %math.conv.s2f
// CHECK-DAG: %math.arith.div

#map = affine_map<(d0, d1, d2, d3) -> (d0, d1, d2, d3)>
#map1 = affine_map<(d0, d1) -> (d0, d1)>
#map2 = affine_map<(d0, d1) -> (d1)>
module {
  func.func @main(%arg0: tensor<2x1x28x28xf32>) -> tensor<2x10xf32> {
    %cst = arith.constant dense_resource<torch_tensor_4_torch.float32> : tensor<4xf32>
    %c2_i64 = arith.constant 2 : i64
    %cst_0 = arith.constant 0.000000e+00 : f32
    %cst_1 = arith.constant 0xFF800000 : f32
    %c10_i64 = arith.constant 10 : i64
    %cst_2 = arith.constant dense_resource<torch_tensor_4_1_5_5_torch.float32> : tensor<4x1x5x5xf32>
    %cst_3 = arith.constant dense_resource<torch_tensor_6_4_5_5_torch.float32> : tensor<6x4x5x5xf32>
    %cst_4 = arith.constant dense_resource<torch_tensor_6_torch.float32> : tensor<6xf32>
    %cst_5 = arith.constant dense_resource<torch_tensor_150_10_torch.float32> : tensor<150x10xf32>
    %cst_6 = arith.constant dense_resource<torch_tensor_10_torch.float32> : tensor<10xf32>
    %padded = tensor.pad %arg0 low[0, 0, 2, 2] high[0, 0, 2, 2] {
    ^bb0(%arg1: index, %arg2: index, %arg3: index, %arg4: index):
      tensor.yield %cst_0 : f32
    } : tensor<2x1x28x28xf32> to tensor<2x1x32x32xf32>
    %0 = tensor.empty() : tensor<2x4x28x28xf32>
    %broadcasted = linalg.broadcast ins(%cst : tensor<4xf32>) outs(%0 : tensor<2x4x28x28xf32>) dimensions = [0, 2, 3] 
    %1 = linalg.conv_2d_nchw_fchw {dilations = dense<1> : vector<2xi64>, strides = dense<1> : vector<2xi64>} ins(%padded, %cst_2 : tensor<2x1x32x32xf32>, tensor<4x1x5x5xf32>) outs(%broadcasted : tensor<2x4x28x28xf32>) -> tensor<2x4x28x28xf32>
    %2 = linalg.generic {indexing_maps = [#map, #map], iterator_types = ["parallel", "parallel", "parallel", "parallel"]} ins(%1 : tensor<2x4x28x28xf32>) outs(%0 : tensor<2x4x28x28xf32>) {
    ^bb0(%in: f32, %out: f32):
      %18 = arith.cmpf ugt, %in, %cst_0 : f32
      %19 = arith.select %18, %in, %cst_0 : f32
      linalg.yield %19 : f32
    } -> tensor<2x4x28x28xf32>
    %3 = tensor.empty() : tensor<2x4x14x14xf32>
    %4 = linalg.fill ins(%cst_1 : f32) outs(%3 : tensor<2x4x14x14xf32>) -> tensor<2x4x14x14xf32>
    %5 = tensor.empty() : tensor<2x2xf32>
    %6 = linalg.pooling_nchw_max {dilations = dense<1> : vector<2xi64>, strides = dense<2> : vector<2xi64>} ins(%2, %5 : tensor<2x4x28x28xf32>, tensor<2x2xf32>) outs(%4 : tensor<2x4x14x14xf32>) -> tensor<2x4x14x14xf32>
    %7 = tensor.empty() : tensor<2x6x10x10xf32>
    %broadcasted_7 = linalg.broadcast ins(%cst_4 : tensor<6xf32>) outs(%7 : tensor<2x6x10x10xf32>) dimensions = [0, 2, 3] 
    %8 = linalg.conv_2d_nchw_fchw {dilations = dense<1> : vector<2xi64>, strides = dense<1> : vector<2xi64>} ins(%6, %cst_3 : tensor<2x4x14x14xf32>, tensor<6x4x5x5xf32>) outs(%broadcasted_7 : tensor<2x6x10x10xf32>) -> tensor<2x6x10x10xf32>
    %9 = linalg.generic {indexing_maps = [#map, #map], iterator_types = ["parallel", "parallel", "parallel", "parallel"]} ins(%8 : tensor<2x6x10x10xf32>) outs(%7 : tensor<2x6x10x10xf32>) {
    ^bb0(%in: f32, %out: f32):
      %18 = arith.cmpf ugt, %in, %cst_0 : f32
      %19 = arith.select %18, %in, %cst_0 : f32
      linalg.yield %19 : f32
    } -> tensor<2x6x10x10xf32>
    %10 = tensor.empty() : tensor<2x6x5x5xf32>
    %11 = linalg.fill ins(%cst_0 : f32) outs(%10 : tensor<2x6x5x5xf32>) -> tensor<2x6x5x5xf32>
    %12 = linalg.pooling_nchw_sum {dilations = dense<1> : vector<2xi64>, strides = dense<2> : vector<2xi64>} ins(%9, %5 : tensor<2x6x10x10xf32>, tensor<2x2xf32>) outs(%11 : tensor<2x6x5x5xf32>) -> tensor<2x6x5x5xf32>
    %13 = linalg.generic {indexing_maps = [#map, #map], iterator_types = ["parallel", "parallel", "parallel", "parallel"]} ins(%12 : tensor<2x6x5x5xf32>) outs(%10 : tensor<2x6x5x5xf32>) {
    ^bb0(%in: f32, %out: f32):
      %18 = linalg.index 2 : index
      %19 = arith.index_cast %18 : index to i64
      %20 = linalg.index 3 : index
      %21 = arith.index_cast %20 : index to i64
      %22 = arith.muli %19, %c2_i64 : i64
      %23 = arith.muli %21, %c2_i64 : i64
      %24 = arith.addi %22, %c2_i64 : i64
      %25 = arith.minsi %24, %c10_i64 : i64
      %26 = arith.addi %23, %c2_i64 : i64
      %27 = arith.minsi %26, %c10_i64 : i64
      %28 = arith.subi %25, %22 : i64
      %29 = arith.subi %27, %23 : i64
      %30 = arith.muli %28, %29 : i64
      %31 = arith.sitofp %30 : i64 to f32
      %32 = arith.divf %in, %31 : f32
      linalg.yield %32 : f32
    } -> tensor<2x6x5x5xf32>
    %collapsed = tensor.collapse_shape %13 [[0], [1, 2, 3]] : tensor<2x6x5x5xf32> into tensor<2x150xf32>
    %14 = tensor.empty() : tensor<2x10xf32>
    %15 = linalg.fill ins(%cst_0 : f32) outs(%14 : tensor<2x10xf32>) -> tensor<2x10xf32>
    %16 = linalg.matmul ins(%collapsed, %cst_5 : tensor<2x150xf32>, tensor<150x10xf32>) outs(%15 : tensor<2x10xf32>) -> tensor<2x10xf32>
    %17 = linalg.generic {indexing_maps = [#map1, #map2, #map1], iterator_types = ["parallel", "parallel"]} ins(%16, %cst_6 : tensor<2x10xf32>, tensor<10xf32>) outs(%14 : tensor<2x10xf32>) {
    ^bb0(%in: f32, %in_8: f32, %out: f32):
      %18 = arith.addf %in, %in_8 : f32
      linalg.yield %18 : f32
    } -> tensor<2x10xf32>
    return %17 : tensor<2x10xf32>
  }
}

{-#
  dialect_resources: {
    builtin: {
      torch_tensor_4_torch.float32: "0x0400000025E1D3BE809A4940913FF83FAFD27E3F",
      torch_tensor_4_1_5_5_torch.float32: "",
      torch_tensor_6_4_5_5_torch.float32: "",
      torch_tensor_6_torch.float32: "0x04000000F98DECBB07541F3F0E4720BE38A464BFFE8C3D3F19ADCDBE",
      torch_tensor_150_10_torch.float32: "",
      torch_tensor_10_torch.float32: "0x04000000D453183DA8AB20BF6EAB1A3F114326BF3386AF3F9A4DE9BFE95A2EBD537362BEC077B1BE31650C3F"
    }
  }
#-}
